<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rest_api_client_secret_view_form" model="ir.ui.view">
        <field name="name">rest.api.client.secret.form</field>
        <field name="model">rest.api.client.secret</field>
        <field name="arch" type="xml">
            <form string="New Client Secret">
                <div class="alert alert-warning" role="alert">
                    Copy this secret now. It is stored only as a hash and cannot be shown again.
                </div>
                <group>
                    <field name="client_id" widget="CopyClipboardChar"/>
                    <field name="client_secret" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button string="Done" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
